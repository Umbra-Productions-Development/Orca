{
  "project": "myproj",
  "sharedDir": "/abs/path/to/main-checkout/.orca",
  "baseBranch": "main",
  "gate": "npm run lint && npm run typecheck && npm test",
  "leakCheck": true,
  "testCommand": "npx vitest run",
  "testGlob": "\\.test\\.tsx?$",
  "sourceGlob": "src/|\\.tsx?\\b",
  "ticketPattern": "ABC-[0-9]+",
  "tracker": "",
  "roles": { "Orchestrator": "orchestrator", "Propose": "propose", "Apply": "apply", "Review": "review" },
  "reviewPasses": ["security-review"],
  "applyChecks": [],
  "reviewChecks": [{ "do": "Open each changed screen on the ticket's stack and check it renders", "when": "\\.tsx$" }],
  "envFiles": [".env"],
  "linkPaths": [],
  "envCommand": "",
  "ports": ["web", "db"],
  "portScheme": { "base": 3000, "slots": 100, "step": 10 },
  "stackUp": "./scripts/stack-up.sh",
  "stackDown": "./scripts/stack-down.sh",
  "migrateCommand": "",
  "prShareLimit": 1500,
  "stackTool": "auto",
  "discoveriesDir": "discoveries",
  "handoffArchiveDays": 7
}
