#!/usr/bin/env bash
# Fake herdr for tests: every call is appended to $HERDR_STUB/calls; `pane split` hands out pane p1.
# HERDR_STUB_RUN_FAIL=1 makes `pane run` fail, as when the pane is closed under it.
echo "$*" >> "$HERDR_STUB/calls"
case "$1 ${2:-}" in
  "pane split") echo '{"result":{"pane":{"pane_id":"p1"}}}';;
  "pane run") [ -z "${HERDR_STUB_RUN_FAIL:-}" ] || exit 1;;
esac
