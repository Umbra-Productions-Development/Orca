#!/usr/bin/env bash
# orca-lc — orchestrated development lifecycle for Claude Code sessions. Project config: <repo>/.orca/config.json
set -uo pipefail

USAGE='usage: orca-lc <command> [args]
  context                          state for this session (SessionStart runs it)
  gate [--inline]                  run the project gate, write the marker
  gate-fresh                       exit 0 when the marker matches the tree
  test-affected                    run only test files affected by the diff
  evidence [base]                  write blast radius + affected tests for the diff
  leak-check [range]|--pre-push    scan commits for denylisted terms (location + denylist line, never the term)
  leak-check --file <path>...|--stdin <label>   scan files (as file:<n>, the path as file path:1) or stdin (as <label>:<n>)
  peers                            live sessions on any worktree of this repo
  name [--set]                     this session identity (--set writes it once)
  ticket                           ticket of this directory or its branch, empty when none
  notify <target> <text>           message a peer: session id/prefix, name, pane id, or ticket [--role r]
  inbox send <ticket> <text>|read  queue for a ticket with no live session / drain
  handoff write <t> <role> [--as <name>]|read <t> [role]|list|consume <file>
  discover <slug> "<rule>" [hook|skill|memory|reference|none]
  discover set <slug> <enforced-by> | archive <slug>
  triage                           discoveries nothing enforces yet
  tidy                             archive consumed handoffs and old inbox
  review-queue                     open PRs by others awaiting my review
  test-lock on|off|status          allow edits to test files in this worktree
  worktree up <ticket> [branch] [--stack] | down <ticket> [--force]
  role start <ticket> <role> [--as <name>] < body   tab + named agent + handoff (body on stdin) + first prompt
  role owner <ticket> [--set <role>]  the role that owns the ticket now
  stack add <change>|list|rebase|prs  stacked PRs: a branch per change in this worktree
  config <key>                     read a key from .orca/config.json'

die() { echo "orca-lc: $*" >&2; exit 1; }
usage() { echo "orca-lc: $1" >&2; echo "$USAGE" >&2; exit 2; }
need() { [ -n "${2:-}" ] || usage "missing <$1>"; }
root() { git rev-parse --show-toplevel 2>/dev/null; }
# The main checkout, also from a linked worktree: the parent of the common git dir.
main_root() { local c; c=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1; dirname "$c"; }
gitdir() { git rev-parse --git-dir 2>/dev/null; }
cfgfile() { local r; r=$(root) || return 1; [ -f "$r/.orca/config.json" ] && echo "$r/.orca/config.json"; }
cfg() { local f; f=$(cfgfile) || { echo "${2:-}"; return; }; local v; v=$(jq -r "$1 // empty" "$f" 2>/dev/null); echo "${v:-${2:-}}"; }
shared() { cfg '.sharedDir' "$(root)/.orca"; }
ticket() { local p="${1:-$PWD}" pat; pat=$(cfg '.ticketPattern' '[A-Z]+-[0-9]+'); tkey "$( { echo "$p"; git branch --show-current 2>/dev/null; } | grep -oiE "$pat" | head -1)"; }
# The one case a ticket takes wherever it keys shared state (handoffs, inbox, owners, identity).
tkey() { echo "$1" | tr 'A-Z' 'a-z'; }
# A handoff's front-matter field (between the opening --- and the next), never a body line that looks like one.
fm() { sed -n "2,/^---\$/{s/^$1: //p;}" "$2" | head -1; }
# A free path for name in dir: name, then name-2, name-3, ... before the extension.
free_path() { local b e t i=2; b="${2%.md}"; e="${2#"$b"}"; t="$1/$2"; while [ -e "$t" ]; do t="$1/$b-$i$e"; i=$((i+1)); done; echo "$t"; }
# Moves a file into dir under a free name (its own, or the third argument); prints where it went.
# mv -n skips quietly when a concurrent move takes the name first, so retry until the source is gone.
mv_free() { local t i; mkdir -p "$2"; for i in 1 2 3; do t=$(free_path "$2" "${3:-$(basename "$1")}"); mv -n "$1" "$t" || return 1
  [ -e "$1" ] || { echo "$t"; return 0; }; done; return 1; }
# A ticket's folder under handoffs/ or inbox/. A folder for the same ticket in another case, made by
# an older orca-lc (ABC-1 beside abc-1), is folded into it on first use, every file kept. On a
# case-insensitive filesystem the two names are one folder, so it is left alone.
tdir() { local k o f; k=$(tkey "$2")
  for o in "$1"/*/; do o="${o%/}"; [ "$o" != "$1/$k" ] && ! [ "$o" -ef "$1/$k" ] && [ "$(tkey "$(basename "$o")")" = "$k" ] || continue
    (cd "$o" && find . -type f) | while read -r f; do mv_free "$o/$f" "$1/$k/$(dirname "$f")" >/dev/null; done
    find "$o" -depth -type d -empty -delete; done
  echo "$1/$k"; }
# kill -0 also fails for a live process of another user (EPERM); only "No such process" means gone.
pid_gone() { local e; e=$(LC_ALL=C kill -0 "$1" 2>&1); [[ $e == *'No such process'* ]]; }
# Holds an exclusive lock on path until the script exits: flock where installed, else a mkdir lock
# (macOS and Git Bash ship no flock). Either gives up after 10s. The two do not exclude each other,
# so one sharedDir is used from one kind of host. The mkdir lock records its pid; a dir whose pid is
# dead (a holder killed before its trap ran) is reclaimed, under a second mkdir so two waiters
# cannot both reclaim it.
lock() { if command -v flock >/dev/null; then exec 9>"$1"; flock -w 10 9 || die "could not lock $1 in 10s"; return; fi
  local d="$1.d" i=0 p
  until mkdir "$d" 2>/dev/null; do
    p=$(cat "$d/pid" 2>/dev/null) && [ -n "$p" ] && pid_gone "$p" && mkdir "$d.reclaim" 2>/dev/null && {
      [ "$(cat "$d/pid" 2>/dev/null)" = "$p" ] && rm -rf "$d"; rmdir "$d.reclaim"; continue; }
    i=$((i+1)); [ "$i" -lt 100 ] && { sleep 0.1; continue; }
    [ -d "$d.reclaim" ] && die "lock held: $d and $d.reclaim (remove both if no orca-lc is running)"
    die "lock held: $d (remove it if no orca-lc is running)"; done
  echo $$ >"$d/pid"; trap 'rm -rf "'"$d"'"' EXIT; }
inherdr() { [ "${HERDR_ENV:-}" = 1 ]; }
tree_sig() { printf '%s %s\n' "$(git rev-parse HEAD)" "$( { git diff HEAD; git ls-files --others --exclude-standard | sort; } | sha1sum | cut -c1-12)"; }
marker() { echo "$(gitdir)/orca-gate-ok"; }
idfile() { echo "$(gitdir)/orca-session-${HERDR_PANE_ID:-nopane}.json"; }

# ---- identity: written once by `name --set` (SessionStart), read everywhere else
role_from_tab() {
  [ -n "${ORCA_ROLE:-}" ] && { echo "$ORCA_ROLE"; return; } # set by `role start` on the tab it creates
  inherdr || { echo session; return; }
  local label; label=$(herdr tab list --workspace "$HERDR_WORKSPACE_ID" 2>/dev/null | jq -r --arg t "$HERDR_TAB_ID" '.result.tabs[] | select(.tab_id==$t) | .label // .title // ""')
  local f; f=$(cfgfile) || { echo session; return; }
  # Labels vary by who made the tab (Propose, abc12-apply, orchestrator): drop case and the ticket
  # prefix, map through .roles, and take a bare role name as itself.
  local t; t=$(ticket)
  jq -r --arg l "$label" --arg t "$t" '($l | ascii_downcase | ltrimstr(($t | gsub("-"; "")) + "-") | ltrimstr($t + "-")) as $k
    | ((.roles // {}) | with_entries(.key |= ascii_downcase))[$k]
      // (if ["orchestrator","propose","apply","review"] | index($k) then $k else "session" end)' "$f"
}
cmd_name() {
  local f; f=$(idfile)
  if [ "${1:-}" = "--set" ]; then
    local sid="${CLAUDE_SESSION_ID:-}" t r n base i=1
    t=$(ticket); [ -n "$t" ] || t=$(cfg '.project' proj); r=$(role_from_tab); n="${t//-/}-$r"; base="$n"
    if inherdr; then
      while herdr agent list | jq -e --arg n "$n" --arg me "${HERDR_PANE_ID:-}" '.result.agents[] | select((.agent_name // .name)==$n and .pane_id!=$me)' >/dev/null 2>&1; do i=$((i+1)); n="$base$i"; done
      herdr agent rename "$HERDR_PANE_ID" "$n" >/dev/null 2>&1
    fi
    jq -n --arg id "$sid" --arg n "$n" --arg t "$t" --arg r "$r" --arg p "${HERDR_PANE_ID:-}" --arg c "$PWD" '{id:$id,name:$n,ticket:$t,role:$r,pane:$p,cwd:$c}' > "$f"
  fi
  [ -f "$f" ] || { jq -n --arg c "$PWD" --arg t "$(ticket)" '{id:"",name:"",ticket:$t,role:"session",pane:"",cwd:$c}'; return; }
  cat "$f"
}
me() { cmd_name | jq -r ".$1"; }
# Sender for message headers: a session that never ran `name --set` still says which pane it is.
me_tag() { local i n; i=$(me id | cut -c1-8); n=$(me name); echo "${i:-pane:${HERDR_PANE_ID:-none}} ${n:--} cwd=$(me cwd)"; }

cmd_config() { need key "${1:-}"; cfg ".$1"; }
cmd_gate_fresh() { [ -f "$(marker)" ] && [ "$(cat "$(marker)")" = "$(tree_sig)" ]; }

load_env() { [ -f .env ] && { set -a; . ./.env; set +a; }
  local ec; ec=$(cfg '.envCommand'); [ -n "$ec" ] || return 0
  local kv; kv=$(bash -c "$ec" 2>/dev/null); [ -n "$kv" ] && { set -a; eval "$kv"; set +a; echo "orca-lc: env: $kv"; }; }

cmd_gate() {
  local r; r=$(root) || die "not in a repo"
  local g; g=$(cfg '.gate'); [ -n "$g" ] || die "no gate in .orca/config.json"
  if [ "${1:-}" != "--inline" ] && inherdr; then
    local old; old="$(gitdir)/orca-gate-pane"; [ -f "$old" ] && { herdr pane close "$(cat "$old")" >/dev/null 2>&1; rm -f "$old"; }
    local pane; pane=$(herdr pane split --current --direction down --cwd "$r" --no-focus 2>/dev/null | jq -r '.result.pane.pane_id // empty')
    if [ -z "$pane" ]; then echo "orca-lc: no pane available, running inline"; else
      herdr pane run "$pane" "orca-lc gate --inline" >/dev/null
      herdr pane wait-output "$pane" --regex 'ORCA_GATE_(PASS|FAIL)$' --timeout 1200000 >/dev/null
      herdr pane read "$pane" --source recent-unwrapped --lines 200 | tail -60
      if cmd_gate_fresh; then herdr pane close "$pane" >/dev/null; echo "orca-lc: gate PASS, pane closed"; return 0; fi
      echo "$pane" > "$old"; echo "orca-lc: gate FAIL, pane $pane left open (closed automatically on the next run)"; return 1
    fi
  fi
  cd "$r" || exit 1; rm -f "$(marker)"; load_env
  echo "orca-lc: gate on $(git branch --show-current) @ $(git rev-parse --short HEAD)"
  if bash -c "$g"; then
    if [ "$(cfg '.leakCheck')" = true ]; then
      # Subshell: no exit inside the scan may end the gate before it prints its last line.
      echo "orca-lc: leak-check on commits not on any remote"
      ( cmd_leak_check ) || { echo "ORCA_GATE_FAIL"; return 1; }
    fi
    tree_sig > "$(marker)"; echo "ORCA_GATE_PASS"; return 0
  fi
  echo "ORCA_GATE_FAIL"; return 1
}

# ---- leak check: denylists are untracked; a committed list would itself be the leak.
# Syntax follows .gitignore: one pattern per line, `#` comments, `*` wildcard, `!` re-allows,
# last matching line wins. Matching ignores case and only hits whole words.
leak_global() { echo "${XDG_CONFIG_HOME:-$HOME/.config}/orca/denylist"; }
leak_lists() { # global first, then this clone's: the later list wins a tie
  # An unreadable list is named by kind, never by its path, and fails closed with 2.
  local f k; for k in global project; do
    if [ $k = global ]; then f="$(leak_global)"; else f="$(root)/.orca/denylist"; fi
    [ -f "$f" ] || continue
    [ -r "$f" ] || { echo "orca-lc: leak-check: $k denylist unreadable" >&2; return 2; }
    echo "$f"
  done; return 0
}
leak_scan() { # <list>...; stdin: "<where>\t<text>" lines; prints one line per blocked hit
  # A commit location whose path matches any deny pattern, re-allowed or not, is cut to "commit <sha> added line",
  # so no line carries a term. Lists are named "global denylist" or "project denylist", never by their path.
  G="$(leak_global)" awk -F'\t' '
    function blocked(s,   i, h) { h = 0; for (i = 1; i <= n; i++) if (s ~ pat[i]) h = deny[i] ? i : 0; return h }
    function denied(s,   i) { for (i = 1; i <= n; i++) if (deny[i] && s ~ pat[i]) return 1; return 0 }
    FILENAME != "-" {
      line = $0; sub(/\r$/, "", line)
      if (line ~ /^[ \t]*(#|$)/) next
      neg = (substr(line, 1, 1) == "!"); if (neg) line = substr(line, 2)
      gsub(/^[ \t]+|[ \t]+$/, "", line)
      re = tolower(line)
      gsub(/[][\\.^$+?(){}|\/]/, "\\\\&", re)
      gsub(/\*/, ".*", re)
      n++; pat[n] = "(^|[^[:alnum:]])" re "([^[:alnum:]]|$)"; deny[n] = !neg
      src[n] = (FILENAME == ENVIRON["G"] ? "global" : "project") " denylist:" FNR
      next
    }
    {
      where = $1; hit = blocked(tolower(substr($0, length($1) + 2)))
      if (hit && where ~ /^commit /) {
        split(where, w, " "); f = substr(where, length(w[1] w[2]) + 3)
        if (f != "message" && f != "path" && denied(tolower(f))) where = w[1] " " w[2] " added line"
      }
      if (hit) print where "  (" src[hit] ")"
    }
  ' "$@" -
}
leak_commits() { # <branch> <git log args>...: the branch name, then per commit its people, message, paths and added lines
  local b="$1" cs c p; shift
  # A failed git log must not read as clean: exit 2, without echoing the range git would name.
  cs=$(git log --format='%h' "$@" 2>/dev/null) || {
    echo "orca-lc: leak-check: bad range: a commit in it is not in this clone (a typo, or run git fetch first)" >&2; exit 2; }
  printf 'branch name\t%s\n' "$b"
  [ -n "$cs" ] && while read -r c; do
    git show -s --format='%an%n%ae%n%cn%n%ce%n%B' "$c" | sed "s/^/commit $c message\t/"
    # Paths from --name-only, so a binary or empty file, which has no +++ line, is scanned too. -z leaves them
    # unquoted; tabs and newlines become spaces. A deleted path is left out: refusing it would block removing it.
    git show --format= --name-only -z --no-renames --diff-filter=d "$c" | while IFS= read -r -d '' p; do
      [ -n "$p" ] && printf 'commit %s path\t%s\n' "$c" "${p//[$'\t\r\n']/ }"; done
    # The +++ path only says which file an added line belongs to, and counts only in a file header (after
    # diff --git and its --- line), so an added line that starts with "++ " is not read as one. It comes back
    # unquoted (git C-quotes tabs, newlines, quotes and backslashes even with quotePath off), escapes as spaces.
    git -c core.quotePath=false show --format= -p --no-renames --src-prefix=a/ --dst-prefix=b/ "$c" | awk -v c="$c" '
      function unq(s,   o, i, ch) {
        if (substr(s, 1, 1) != "\"") return s
        s = substr(s, 2, length(s) - 2); o = ""
        for (i = 1; i <= length(s); i++) {
          ch = substr(s, i, 1)
          if (ch == "\\") { ch = substr(s, ++i, 1); if (ch ~ /[0-7]/) { ch = " "; i += 2 } else if (ch ~ /[abfnrtv]/) ch = " " }
          o = o ch
        }
        return o
      }
      /^diff --(git|cc|combined) / { h = 1; next }
      h == 1 && /^--- / { h = 2; next }
      h == 2 && /^\+\+\+ / { f = unq(substr($0, 5)); gsub(/[\t\r\n]/, " ", f); sub(/^b\//, "", f); h = 0; next }
      h { if (/^@@/) h = 0; next }
      /^\+/ { print "commit " c " " f "\t" substr($0, 2) }'
  done <<<"$cs"
  return 0
}
leak_lines() { L="$1" awk '{ print ENVIRON["L"] ":" NR "\t" $0 }'; } # <label>; stdin: lines out as "<label>:<n>\t<line>"
# <where> <text> [<where> <text>]...: with leakCheck on, refuse text carrying a denylisted term before it is written.
leak_guard() {
  [ "$(cfg '.leakCheck')" = true ] || return 0
  local lists=() f l hits
  f=$(leak_lists) || return 2; while IFS= read -r l; do [ -n "$l" ] && lists+=("$l"); done <<<"$f"
  [ ${#lists[@]} -gt 0 ] || return 0
  hits=$(while [ $# -ge 2 ]; do printf '%s\n' "$2" | L="$1" awk '{ print ENVIRON["L"] "\t" $0 }'; shift 2; done | leak_scan "${lists[@]}")
  [ -z "$hits" ] && return 0
  echo "leak-check: denylisted terms found. Location, then the denylist line that matched:" >&2
  echo "$hits" | sort -u >&2; echo "orca-lc: refused, nothing written" >&2
  return 1
}
# Returns rather than exits, so the gate keeps control; no mode reads the config or needs jq.
cmd_leak_check() {
  local mode=range lists=() f l found head="leak-check: denylisted terms found."
  case "${1:-}" in
    --pre-push) mode=pre-push; shift; [ $# -eq 0 ] || usage "leak-check --pre-push takes no arguments";;
    --file) mode="file"; shift; [ $# -gt 0 ] || usage "leak-check --file <path>..."
            for f; do [ -f "$f" ] || usage "leak-check: no such file"; [ -r "$f" ] || usage "leak-check: unreadable file"; done;;
    --stdin) mode=stdin; shift; [ $# -eq 1 ] && [ -n "$1" ] || usage "leak-check --stdin <label>";;
    -*) usage "leak-check: unknown flag '$1'";;
    *) [ $# -le 1 ] || usage "leak-check takes one range";;
  esac
  # A while-read loop, not mapfile: macOS ships bash 3.2, where a missing mapfile would leave no lists.
  f=$(leak_lists) || return 2; while IFS= read -r l; do [ -n "$l" ] && lists+=("$l"); done <<<"$f"
  if [ ${#lists[@]} -eq 0 ]; then [ "$mode" = range ] && echo "leak-check: no denylist, skipped" >&2; return 0; fi
  if [ "$mode" = file ]; then
    # Locations never carry the path: it is scanned as its own line, and content lines are "file:<n>".
    # Content goes in on stdin: awk would take a path operand holding "=" as an assignment. A newline in a path is
    # flattened so no part of it escapes the "file path" label.
    found=$(for f; do printf 'file path:1\t%s\n' "${f//$'\n'/ }"; leak_lines file < "$f"; done | leak_scan "${lists[@]}") || return 2
  elif [ "$mode" = stdin ]; then
    found=$(leak_lines "$1" | leak_scan "${lists[@]}") || return 2
  elif [ "$mode" = pre-push ]; then
    local zero=0000000000000000000000000000000000000000 lsha rref rsha
    found=$(while read -r _ lsha rref rsha; do
      [ "$lsha" = "$zero" ] && continue
      if [ "$rsha" = "$zero" ]; then leak_commits "${rref#refs/heads/}" "$lsha" --not --remotes
      else leak_commits "${rref#refs/heads/}" "$rsha..$lsha"; fi
    done | leak_scan "${lists[@]}") || return 2
    head="pre-push: denylisted terms found, push refused."
  else
    # pipefail carries leak_commits' exit 2 out of the pipeline.
    if [ $# -eq 1 ]; then found=$(leak_commits "$(git branch --show-current)" "$1" | leak_scan "${lists[@]}") || return 2
    else found=$(leak_commits "$(git branch --show-current)" HEAD --not --remotes | leak_scan "${lists[@]}") || return 2; fi
  fi
  [ -z "$found" ] && return 0
  echo "$head Location, then the denylist line that matched:" >&2
  echo "$found" | sort -u >&2
  return 1
}

base_ref() { local b; b=$(cfg '.baseBranch' main); git merge-base HEAD "$b" 2>/dev/null || git rev-parse HEAD~1; }
has() { command -v "$1" >/dev/null; }
ensure_graphs() { # codegraph and codebase-memory indexes for this checkout, when those tools are installed
  has codegraph && { [ -d .codegraph ] || codegraph init >/dev/null 2>&1; }
  has codebase-memory-mcp && { codebase-memory-mcp cli index_status --project "$(cbm_project)" >/dev/null 2>&1 || codebase-memory-mcp cli index_repository --repo-path "$PWD" --mode fast >/dev/null 2>&1; }
  return 0
}
cbm_project() { echo "$PWD" | sed 's|^/||; s|/|-|g'; }
cmd_test_affected() {
  local tc; tc=$(cfg '.testCommand'); [ -n "$tc" ] || die "set testCommand in .orca/config.json"
  has codegraph || die "test-affected needs codegraph"
  local r; r=$(root) || die "not in a repo"; cd "$r" || exit 1; load_env; ensure_graphs
  local files; files=$( { git diff --name-only "$(base_ref)"; git ls-files --others --exclude-standard; } | sort -u | codegraph affected --stdin --quiet 2>/dev/null)
  [ -n "$files" ] || { echo "orca-lc: no affected test files"; return 0; }
  echo "$files"; bash -c "$tc $(echo "$files" | tr '\n' ' ')"
}
cmd_evidence() {
  local r; r=$(root) || die "not in a repo"; cd "$r" || exit 1; ensure_graphs
  local base="${1:-$(cfg '.baseBranch' main)}" out; out="$(gitdir)/orca-evidence.md"
  { echo "# Change evidence — $(git branch --show-current) vs $base @ $(date -Is)"; echo
    echo "## Blast radius (codebase-memory detect_changes, inbound)"; echo '```'
    if has codebase-memory-mcp; then codebase-memory-mcp cli detect_changes --project "$(cbm_project)" --base-branch "$base" --limit 20 2>/dev/null | awk '/^changed_files:/{skip=1; print; next} /^seed_symbols:/{skip=0} !skip'
    else echo "codebase-memory-mcp not installed"; fi; echo '```'; echo
    echo "## Affected test files (codegraph affected)"; echo '```'
    if has codegraph; then git diff --name-only "$(git merge-base HEAD "$base")" | codegraph affected --stdin --quiet 2>/dev/null
    else echo "codegraph not installed"; fi; echo '```'; echo
    echo "## Changed files"; echo '```'; git diff --stat "$(git merge-base HEAD "$base")" | tail -30; echo '```'
  } > "$out"; echo "$out"
}

repo_wts() { git worktree list --porcelain | awk '/^worktree /{print $2}' | jq -R . | jq -s .; }
agents_json() { herdr agent list 2>/dev/null | jq -c --argjson wts "$(repo_wts)" '[.result.agents[] | select(.cwd as $c | $wts | index($c)) | {name:(.agent_name // .name // ""), status:.agent_status, cwd:.cwd, dir:(.cwd|split("/")|last), tab:.tab_id, pane:.pane_id, sid:(.agent_session.value // ""), title:(.terminal_title_stripped // "")}]'; }
cmd_peers() {
  inherdr || { echo "orca-lc: not inside herdr"; return 0; }
  agents_json | jq -r --arg me "${HERDR_PANE_ID:-}" '.[] | (if .pane==$me then "*" else " " end) + " " + (if .sid=="" then "pane:"+.pane else .sid[0:8] end) + "  " + (.name|if .=="" then "-" else . end) + "  " + .status + "  " + .dir + "  " + .title'
}
resolve_target() { # -> one agent json or list on stderr
  local t="$1" role="${2:-}" a; a=$(agents_json)
  local hit; hit=$(jq -c --arg t "$t" '[.[] | select(.sid!="" and (.sid|startswith($t)))]' <<<"$a")
  [ "$(jq length <<<"$hit")" = 0 ] && hit=$(jq -c --arg t "$t" '[.[] | select(.name==$t or .pane==$t)]' <<<"$a")
  if [ "$(jq length <<<"$hit")" = 0 ]; then
    local tk; tk=$(tkey "$t"); hit=$(jq -c --arg t "$tk" --arg r "$role" '[.[] | select((.dir|ascii_downcase)==$t) | select($r=="" or (.name|endswith("-"+$r)))]' <<<"$a")
  fi
  case "$(jq length <<<"$hit")" in
    0) return 1;;
    1) jq -c '.[0]' <<<"$hit";;
    *) # a ticket with several sessions goes to its owner
       local o; [ -z "$role" ] && o=$(cat "$(owner_file "$t")" 2>/dev/null)
       if [ -n "${o:-}" ]; then local oh; oh=$(jq -c --arg r "$o" '[.[] | select(.name|endswith("-"+$r))]' <<<"$hit"); [ "$(jq length <<<"$oh")" = 1 ] && { jq -c '.[0]' <<<"$oh"; return 0; }; fi
       echo "orca-lc: '$t' matches several sessions, use a session id or --role:" >&2; jq -r '.[] | "  " + (if .sid=="" then "pane:"+.pane else .sid[0:8] end) + "  " + .name + "  " + .dir + "  " + .title' <<<"$hit" >&2; return 2;;
  esac
}
cmd_notify() {
  need target "${1:-}"; local target="$1"; shift; local role=""
  [ "${1:-}" = "--role" ] && { role="$2"; shift 2; }
  need text "${1:-}"; local text="$*"
  local hdr="[orca from $(me_tag)]"
  if inherdr; then
    local hit rc; hit=$(resolve_target "$target" "$role"); rc=$?
    [ $rc = 2 ] && exit 2
    if [ $rc = 0 ]; then
      [ "$(jq -r .status <<<"$hit")" = blocked ] && die "peer is blocked at a prompt, not sending: $(jq -r '.name+" "+.dir' <<<"$hit")"
      local dest; dest=$(jq -r 'if .name!="" then .name else .pane end' <<<"$hit")
      herdr agent prompt "$dest" "$hdr $text" >/dev/null && { echo "sent to $(jq -r '(if .sid=="" then "pane:"+.pane else .sid[0:8] end)+" "+.name+" "+.cwd' <<<"$hit")"; return 0; }
      die "herdr refused the prompt to $dest"
    fi
  fi
  local tk; tk=$(tkey "$(echo "$target" | grep -oiE "$(cfg '.ticketPattern' '[A-Z]+-[0-9]+')" | head -1)")
  [ -n "$tk" ] || die "no live session matches '$target' and it is not a ticket, nothing queued"
  local q; q=$(cmd_inbox send "$tk" "$text") || exit $?
  echo "no live session for $tk, queued: $q"
}

cmd_inbox() {
  local d; d="$(shared)/inbox"
  case "${1:-}" in
    send) need ticket "${2:-}"; need text "${3:-}"; local td; td=$(tdir "$d" "$2"); shift 2; leak_guard "inbox send text" "$*" || exit $?; mkdir -p "$td"; local i; i=$(me id | cut -c1-8)
          local f; f=$(free_path "$td" "$(date +%s)-${i:-anon}.md")
          printf 'from: %s\nat: %s\n\n%s\n' "$(me_tag)" "$(date -Is)" "$*" > "$f"; echo "$f";;
    read) local t="${2:-$(ticket)}"; [ -n "$t" ] || return 0; local td; td=$(tdir "$d" "$t"); [ -d "$td" ] || return 0
          for f in "$td"/*.md; do [ -f "$f" ] || continue; echo "--- inbox: $(basename "$f")"; cat "$f"; mv_free "$f" "$td/archive" >/dev/null; done;;
    *) usage "inbox send|read";;
  esac
}

cmd_handoff() {
  local d; d="$(shared)/handoffs"; mkdir -p "$d"
  case "${1:-}" in
    write) need ticket "${2:-}"; need role "${3:-}"; local t r as="" td id o ob old=(); t=$(tkey "$2"); r="$3"
           if [ "${4:-}" = --as ]; then need name "${5:-}"; as="$5"; elif [ -n "${4:-}" ]; then usage "handoff write <ticket> <role> [--as <name>]"; fi
           td=$(tdir "$d" "$t"); mkdir -p "$td"; id=$(me id)
           # One live handoff per ticket and role: a second session would split the work. The lock makes check, replace and write one step.
           lock "$td/.lock"
           for o in "$td"/*.md; do [ -f "$o" ] || continue
             [ "$(fm role "$o")" = "$r" ] && [ -z "$(fm consumed-by "$o")" ] || continue
             ob=$(fm by "$o")
             [ -n "$as" ] || [ -n "$id" ] || die "live $r handoff for $t: $o; no session id here, pass --as <name>"
             [ -n "$as" ] || [ "$ob" = "$id" ] || die "live $r handoff for $t from session ${ob:-unknown}: $o (read it, or pass --as <name> to write anyway)"
             old+=("$o")
           done
           # The new handoff replaces the live one (a rewrite, or a takeover with --as), so archive it.
           for o in ${old[@]+"${old[@]}"}; do cmd_handoff consume "$o" >/dev/null || die "could not archive $o"; done
           local f ax=""; f=$(free_path "$td" "$r-$(date +%F-%H%M%S).md"); [ -n "$as" ] && ax="as: $as"$'\n'
           printf -- '---\nticket: %s\nrole: %s\nwritten: %s\nby: %s\n%sconsumed-by:\n---\n\n' "$t" "$r" "$(date -Is)" "$id" "$ax" > "$f"
           # The role's boundaries come from the skill's Roles section, so a session gets them even when the writer forgets.
           local b; b=$(awk -v h="### $r" '$0==h{on=1;next} on&&/^#/{exit} on&&NF' "$(dirname "$(readlink -f "$0")")/../skills/orca/SKILL.md" 2>/dev/null)
           [ -n "$b" ] && printf '## Role: %s\n%s\nPush, PRs, and tracker writes happen only when the user asks for them in the current turn.\n\n' "$r" "$b" >> "$f"
           # Apply and review work against the ticket's own stack; name its ports so nobody guesses.
           case "$r" in apply|review) local sp; sp=$(stack_ports "$t"); [ -n "$sp" ] && printf 'Stack ports: %s\n\n' "$(echo $sp)" >> "$f";; esac
           echo "$f";;
    read)  need ticket "${2:-}"; local t r="${3:-}" f; t=$(tkey "$2"); f=$(ls -t "$(tdir "$d" "$t")"/${r:+$r-[0-9]}*.md 2>/dev/null | head -1); [ -n "$f" ] || die "no handoff for $t ${r:-}"
           cat "$f"; cmd_handoff consume "$f" >/dev/null;;
    consume) need file "${2:-}"; local f="$2"; case "$f" in */archive/*) return 0;; esac; [ -f "$f" ] || die "no handoff at $f"
           # Archived by role and the second it was written, with -2, -3 on a tie, so same-day handoffs never collide.
           local r s; r=$(fm role "$f")
           s=$(fm written "$f" | sed -n 's/^\([0-9]\{4\}-[0-9][0-9]-[0-9][0-9]\)T\([0-9][0-9]\):\([0-9][0-9]\):\([0-9][0-9]\).*/\1-\2\3\4/p')
           [ -n "$s" ] || s=$(date +%F-%H%M%S)
           sed -i "2,/^---\$/s/^consumed-by:.*/consumed-by: $(me id) $(date -Is)/" "$f"; mv_free "$f" "$(dirname "$f")/archive" "${r:-handoff}-$s.md";;
    list)  local o; for o in "$d"/*/; do [ -d "$o" ] && tdir "$d" "$(basename "$o")" >/dev/null; done
           find "$d" -name '*.md' -not -path '*/archive/*' | sort;;
    *) usage "handoff write|read|consume|list";;
  esac
}

disc_dir() { echo "$(shared)/$(cfg '.discoveriesDir' discoveries)"; }
cmd_discover() {
  local d; d=$(disc_dir); mkdir -p "$d"
  case "${1:-}" in
    set) need slug "${2:-}"; need enforced-by "${3:-}"; local f="$d/$2.md"; [ -f "$f" ] || die "no discovery $2"
         case "$3" in hook|skill|memory|reference|none) ;; *) usage "enforced-by must be hook|skill|memory|reference|none";; esac
         sed -i "s/^enforced-by:.*/enforced-by: $3/" "$f"; grep -m1 '^enforced-by' "$f"; return;;
    archive) need slug "${2:-}"; local f="$d/$2.md"; [ -f "$f" ] || die "no discovery $2"
         grep -q '^enforced-by: none' "$f" && die "still enforced by nothing; set hook|skill|memory|reference first"
         mkdir -p "$d/archive"; sed -i "0,/^---$/!{0,/^---$/s//archived: $(date +%F)\n---/}" "$f"; mv "$f" "$d/archive/"; echo "$d/archive/$2.md"; return;;
  esac
  need slug "${1:-}"; need rule "${2:-}"; local slug="$1" rule="$2" by="${3:-none}"
  case "$by" in hook|skill|memory|reference|none) ;; *) usage "enforced-by must be hook|skill|memory|reference|none";; esac
  leak_guard "discover slug" "$slug" "discover rule" "$rule" || exit $?
  local f="$d/$slug.md"; [ -e "$f" ] && die "$f exists"
  printf -- '---\nrule: %s\nenforced-by: %s\nsince: %s\n---\n\n# %s\n\n' "$rule" "$by" "$(date +%F)" "$slug" > "$f"; echo "$f"
}
cmd_triage() { local d; d=$(disc_dir); for f in "$d"/*.md; do [ -f "$f" ] || continue
  if ! head -1 "$f" | grep -q '^---$'; then echo "untagged  $(basename "$f")"
  elif grep -q '^enforced-by: none' "$f"; then echo "none      $(basename "$f")  $(grep -m1 '^rule:' "$f" | cut -c7-)"; fi; done; }

cmd_tidy() { local days; days=$(cfg '.handoffArchiveDays' 7); local d; d="$(shared)"
  find "$d/handoffs" "$d/inbox" -path '*/archive/*' -name '*.md' -mtime +"$days" -print -delete 2>/dev/null
  find "$d/handoffs" -name '*.md' -not -path '*/archive/*' 2>/dev/null | while read -r f; do if [ -n "$(fm consumed-by "$f")" ]; then cmd_handoff consume "$f"; fi; done; }

# gh as the repository's own account: a token exported by the repo's direnv .envrc only reaches
# shells that loaded it. Version-manager shims such as mise may print a banner on stdout.
# The exit status is gh's: grep finding no line to print is not a failure.
ghx() { if command -v direnv >/dev/null; then direnv exec "$(root)" gh "$@"; else gh "$@"; fi | { grep -v '^mise' || true; }; }
cmd_review_queue() { local me; me=$(ghx api user -q .login 2>/dev/null)
  ghx pr list --state open --json number,title,author,isDraft,reviews,updatedAt --limit 50 2>/dev/null | jq -r --arg me "$me" '.[] | select(.isDraft|not) | select(.author.login != $me) | select([.reviews[]?.author.login] | index($me) | not) | "#\(.number)  \(.author.login)  \(.updatedAt[:10])  \(.title)"'; }

cmd_test_lock() { local f; f="$(gitdir)/orca-allow-test-edits"
  case "${1:-status}" in on) touch "$f"; echo "test edits allowed in this worktree";; off) rm -f "$f"; echo "test edits locked";; status) [ -f "$f" ] && echo unlocked || echo locked;; *) usage "test-lock on|off|status";; esac; }

# ---- worktree lifecycle
wt_dir() { echo "$(dirname "$(main_root)")/$(echo "$1" | tr 'a-z' 'A-Z')"; }
# The workspace a worktree is open in. Read from `workspace list`: `worktree list` reports a null
# workspace_id even for worktrees that have one.
wt_ws() { herdr workspace list 2>/dev/null | jq -r --arg d "$1" '.result.workspaces[] | select(.worktree.checkout_path==$d) | .workspace_id' | head -1; }
# Ports a ticket's stack uses: one per name in .ports, from .portScheme. The defaults give
# 3NN0, 3NN1, ... for ticket number NN, so ports stay 4 digits and wrap every 100 tickets. A ticket
# with no trailing number takes its slot from `cksum` of the uppercased id instead: same scheme, same
# ports on every run, though two such tickets can share a slot.
ports_for() { local n; n=$(echo "$1" | grep -oE '[0-9]+$'); [ -n "$n" ] || n=$(printf '%s' "$1" | tr 'a-z' 'A-Z' | cksum | cut -d' ' -f1)
  local base slots step i=0 p; base=$(cfg '.portScheme.base' 3000) slots=$(cfg '.portScheme.slots' 100) step=$(cfg '.portScheme.step' 10)
  for p in $(cfg '.ports[]'); do echo "$(echo "$p" | tr 'a-z-' 'A-Z_')_PORT=$((base + (10#$n % slots) * step + i))"; i=$((i+1)); done; }
# The worktree's .env.local is the ports' truth once written: they may be edited by hand there.
stack_ports() { local f; f="$(wt_dir "$1")/.env.local"; if [ -f "$f" ]; then grep -E '^[A-Z0-9_]+_PORT=' "$f"; else ports_for "$1"; fi; }
# Runs a project command from config in the worktree, with its ticket, path and ports exported.
stack_run() { local t="$1" dir="$2" c; c=$(cfg ".$3"); [ -n "$c" ] || return 0
  (cd "$dir" && set -a && eval "$(stack_ports "$t")" && ORCA_TICKET="$t" ORCA_WORKTREE="$dir" && set +a && bash -c "$c"); }
# Untracked local config the main checkout owns; a worktree points at it instead of holding a copy,
# so editing it once in the main checkout reaches every worktree.
wt_link() { local main="$1" dir="$2" p
  for p in $(cfg '.linkPaths[]'); do
    [ -e "$main/$p" ] || continue
    if [ -L "$dir/$p" ]; then :
    elif [ -e "$dir/$p" ]; then echo "note: $dir/$p is a real file, not a link to the main checkout"
    else mkdir -p "$(dirname "$dir/$p")"; ln -s "$main/$p" "$dir/$p"; fi
  done; }
# Dies unless a stack command can run: its first word past VAR=value prefixes is on PATH or is an
# executable path, a relative one taken from $2 (the worktree, or the main checkout before it exists).
stack_check() { local c w; c=$(cfg ".$1"); [ -n "$c" ] || die "--stack needs $1 in .orca/config.json"
  for w in $c; do case "$w" in *=*) ;; *) break;; esac; done
  case "$w" in /*) [ -x "$w" ];; */*) [ -x "$2/$w" ];; *) command -v "$w" >/dev/null;; esac || die "$1 command '$w' is missing or not executable; nothing created"; }
cmd_worktree() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    up)
      need ticket "${1:-}"; local t; t=$(echo "$1" | tr 'a-z' 'A-Z'); local branch="${2:-}"; local stack=0; for a in "$@"; do [ "$a" = --stack ] && stack=1; done
      [ -n "$branch" ] && [ "$branch" != --stack ] || branch="$(tkey "$t")/work"
      local main; main=$(main_root) || die "not in a repo"; local dir; dir=$(wt_dir "$t")
      # Refuse --stack before creating anything when its command cannot run.
      [ $stack = 1 ] && { if [ -d "$dir" ]; then stack_check stackUp "$dir"; else stack_check stackUp "$main"; fi; }
      if [ ! -d "$dir" ]; then
        # Cut from the remote base: the main checkout's own branch may be stale or somebody else's.
        local base; base="$(cfg '.baseBranch' main)"; git -C "$main" fetch -q origin "$base" 2>/dev/null && base="origin/$base"
        # Reuse the ticket's branch where it exists: the local one as it is, else track the remote one.
        git -C "$main" fetch -q origin "$branch" 2>/dev/null
        if git -C "$main" show-ref -q --verify "refs/heads/$branch"; then git -C "$main" worktree add "$dir" "$branch" || die "git worktree add failed"
        elif git -C "$main" show-ref -q --verify "refs/remotes/origin/$branch"; then git -C "$main" worktree add --track -b "$branch" "$dir" "origin/$branch" || die "git worktree add failed"
        elif inherdr; then herdr worktree create --cwd "$main" --branch "$branch" --base "$base" --path "$dir" --label "$t" --no-focus >/dev/null || die "herdr worktree create failed"
        else git -C "$main" worktree add -b "$branch" "$dir" "$base" || die "git worktree add failed"; fi
      fi
      # Every worktree gets its own workspace, grouped under the repository's: open one for a worktree
      # made outside herdr or whose workspace was closed.
      if inherdr && [ -z "$(wt_ws "$dir")" ]; then
        herdr worktree open --cwd "$main" --path "$dir" --label "$t" --no-focus >/dev/null || die "herdr worktree open failed"
      fi
      inherdr && echo "workspace $(wt_ws "$dir")"
      branch=$(git -C "$dir" branch --show-current)
      [ -e "$dir/.orca" ] || ln -s "$(cfg '.sharedDir' "$main/.orca")" "$dir/.orca"
      wt_link "$main" "$dir"
      for e in $(cfg '.envFiles[]'); do [ -e "$dir/$e" ] || { [ -f "$main/$e" ] && cp "$main/$e" "$dir/$e"; }; done
      local ports; ports=$(ports_for "$t")
      [ -n "$ports" ] && [ ! -e "$dir/.env.local" ] && echo "$ports" > "$dir/.env.local"
      # Keep the generated .env.local out of `git status`. info/exclude is shared by every worktree.
      local ex; ex=$(git -C "$dir" rev-parse --path-format=absolute --git-path info/exclude)
      mkdir -p "$(dirname "$ex")"; grep -qxF .env.local "$ex" 2>/dev/null || echo .env.local >> "$ex"
      echo "worktree $dir on $branch${ports:+; ports $(echo $(stack_ports "$t"))}"
      if [ $stack = 1 ]; then
        stack_run "$t" "$dir" stackUp && echo "stack up" || die "stackUp failed; worktree $dir on $branch is in place without a stack.
  retry:     orca-lc worktree up $t --stack
  tear down: orca-lc worktree down $t --force"
        # The stack's data can predate this branch's migrations.
        if [ -z "$(cfg '.migrateCommand')" ]; then echo "note: no migrateCommand; the stack's data may be behind this branch's migrations"
        else stack_run "$t" "$dir" migrateCommand && echo "migrated" || echo "WARNING: migrateCommand failed"; fi
      else echo "stack not started (add --stack)"; fi
      (cd "$dir" && ensure_graphs) ;;
    down)
      need ticket "${1:-}"; local t; t=$(echo "$1" | tr 'a-z' 'A-Z'); local force=0; [ "${2:-}" = --force ] && force=1
      local dir; dir=$(wt_dir "$t"); [ -d "$dir" ] || die "no worktree at $dir"
      local branch; branch=$(git -C "$dir" branch --show-current)
      if [ $force = 0 ]; then
        local st; st=$(ghx pr list --head "$branch" --state merged --json number 2>/dev/null | jq length)
        [ "${st:-0}" -gt 0 ] || die "no merged PR for $branch; pass --force to tear down anyway"
      fi
      stack_run "$t" "$dir" stackDown
      rm -f "$dir/.orca"; for p in $(cfg '.linkPaths[]'); do [ -L "$dir/$p" ] && rm -f "$dir/$p"; done
      if inherdr; then local ws; ws=$(wt_ws "$dir"); [ -n "$ws" ] && herdr worktree remove --workspace "$ws" --force >/dev/null 2>&1; fi
      local main; main=$(main_root)
      [ -d "$dir" ] && git -C "$main" worktree remove --force "$dir"
      git -C "$main" branch -D "$branch" >/dev/null 2>&1 && echo "local branch $branch deleted"
      echo "torn down $t; remote branch untouched" ;;
    *) usage "worktree up|down";;
  esac
}

# ---- stacked PRs: one branch per change, each cut from the one below, all in the current worktree.
# gh stack (github/gh-stack) does the work when installed. Without it, git config records each
# branch's parent (branch.<b>.orcaParent) and the parent's tip when the branch was cut or last
# rebased (branch.<b>.orcaParentTip): rebase --onto from that tip replays only the branch's own
# commits, so a squash-merged parent drops out of the stack.
stack_tool() { local t; t=$(cfg '.stackTool' auto); [ "$t" = auto ] || { echo "$t"; return; }
  if ghx extension list 2>/dev/null | grep -q 'gh-stack'; then echo gh-stack; else echo git; fi; }
stack_parent() { git config "branch.$1.orcaParent"; }
stack_child() { git config --get-regexp '^branch\..*\.orcaparent$' | awk -v p="$1" '$2==p { sub(/^branch\./, "", $1); sub(/\.orcaparent$/, "", $1); print $1 }'; }
# The stack the current branch is in, bottom first: down to the branch on the base, then up.
stack_branches() { local b p; b=$(git branch --show-current); [ -n "$(stack_parent "$b")" ] || return 0
  while p=$(stack_parent "$b"); [ -n "$(stack_parent "$p")" ]; do b="$p"; done
  while [ -n "$b" ]; do echo "$b"; b=$(stack_child "$b" | head -1); done; }
pr_state() { ghx pr list --head "$1" --state all --json state -q '.[0].state // ""' 2>/dev/null; }
stack_forget() { git config --unset "branch.$1.orcaParent"; git config --unset "branch.$1.orcaParentTip"; }
cmd_stack() {
  local sub="${1:-}"; shift || true
  local base cur tool; base=$(cfg '.baseBranch' main); cur=$(git branch --show-current); tool=$(stack_tool)
  case "$sub" in
    add)
      need change "${1:-}"; [ -n "$cur" ] || die "not on a branch"
      [ "$cur" != "$base" ] || die "a stack starts on a ticket branch, not $base (orca-lc worktree up <ticket>)"
      # Named like the branch below: abc-12/work -> abc-12/<change>.
      local b; case "$cur" in */*) b="${cur%/*}/$1";; *) b=$(ticket); b="${b:+$b/}$1";; esac
      git show-ref -q --verify "refs/heads/$b" && die "branch $b exists"
      git check-ref-format --branch "$b" >/dev/null 2>&1 || die "$b is not a valid branch name"
      if [ "$tool" = gh-stack ]; then
        # gh-stack exits 2 for "not in a stack / stack not found" (its README's exit code table); any
        # other failure (auth, network) must not start a second stack.
        local vs=0; ghx stack view --json >/dev/null 2>&1 || vs=$?
        case $vs in
          0) ghx stack add "$b" >/dev/null || die "gh stack add $b failed" ;;
          # One init adopts $cur and creates $b: no stack left behind with $b missing.
          2) ghx stack init --base "$base" "$cur" "$b" >/dev/null || die "gh stack init failed"
             git checkout -q "$b" || die "git checkout $b failed" ;;
          *) die "gh stack view failed (exit $vs): can't tell whether $cur is already in a stack" ;;
        esac
      else
        # A second child would fork the stack; stack_branches, rebase and prs follow one child only.
        local up; up=$(stack_child "$cur" | head -1)
        [ -z "$up" ] || die "$cur already has $up above it: add from the top of the stack"
        # Branch first: a name git refuses (abc-12/x next to abc-12) leaves no stack config behind.
        git checkout -q -b "$b" || die "git checkout -b $b failed"
        if [ -z "$(stack_parent "$cur")" ]; then
          git config "branch.$cur.orcaParent" "$base"
          git config "branch.$cur.orcaParentTip" "$(git merge-base "$cur" "origin/$base" 2>/dev/null || git merge-base "$cur" "$base")"
        fi
        git config "branch.$b.orcaParent" "$cur"; git config "branch.$b.orcaParentTip" "$(git rev-parse "$cur")"
      fi
      echo "stack: $b on $cur";;
    list)
      [ "$tool" = gh-stack ] && { ghx stack view --short; return; }
      local bs b; bs=$(stack_branches); [ -n "$bs" ] || { echo "orca-lc: $cur is not in a stack (orca-lc stack add <change>)"; return 0; }
      for b in $bs; do
        local pr; pr=$(ghx pr list --head "$b" --state all --json number,state,baseRefName -q '.[0] | select(.) | "#\(.number) \(.state) on \(.baseRefName)"' 2>/dev/null)
        echo "$([ "$b" = "$cur" ] && echo '*' || echo ' ') $b <- $(stack_parent "$b")${pr:+  $pr}"
      done;;
    rebase)
      git fetch -q origin || die "git fetch failed"
      [ "$tool" = gh-stack ] && { ghx stack rebase; return; }
      [ -d "$(git rev-parse --git-path rebase-merge)" ] || [ -d "$(git rev-parse --git-path rebase-apply)" ] && die "a rebase is in progress: finish it (git rebase --continue) and rerun"
      [ -z "$(git status --porcelain --untracked-files=no)" ] || die "uncommitted changes: commit them before rebasing the stack"
      local bs b p op tip mb onto; bs=$(stack_branches); [ -n "$bs" ] || die "$cur is not in a stack"
      for b in $bs; do
        # A merged branch leaves the stack; the branch above moves onto what it merged into.
        [ "$(pr_state "$b")" = MERGED ] && { echo "$b merged; local branch kept"; continue; }
        p=$(stack_parent "$b"); op="$p"; [ "$op" = "$base" ] && op="origin/$base"
        while [ "$p" != "$base" ] && [ "$(pr_state "$p")" = MERGED ]; do
          local pp; pp=$(stack_parent "$p"); git config "branch.$b.orcaParent" "$pp"; stack_forget "$p"; p="$pp"
        done
        tip=$(git config "branch.$b.orcaParentTip"); onto="$p"; [ "$p" = "$base" ] && onto="origin/$base"
        # A hand-rebase (or a lost key) leaves the tip stale: off the branch, or behind where the branch
        # now forks from its old parent. Take whichever of the two is further along.
        mb=$(git merge-base "$op" "$b" 2>/dev/null)
        if [ -z "$tip" ] || ! git merge-base --is-ancestor "$tip" "$b" 2>/dev/null || { [ -n "$mb" ] && git merge-base --is-ancestor "$tip" "$mb"; }; then tip="$mb"; fi
        # Already on top also covers a branch whose conflicted rebase was finished by hand.
        if ! git merge-base --is-ancestor "$onto" "$b"; then
          git rebase -q --onto "$onto" "${tip:-$onto}" "$b" || die "rebasing $b onto $p stopped on a conflict: resolve it, git rebase --continue, then rerun orca-lc stack rebase"
        fi
        git config "branch.$b.orcaParentTip" "$(git rev-parse "$onto")"; echo "$b on $p"
      done
      # Back where we started, or on the top of the stack when that branch merged. A merged branch
      # no child moved off (the top) leaves the stack here, or prs would refuse it forever.
      local top=""; for b in $bs; do
        if [ "$(pr_state "$b")" = MERGED ]; then [ -z "$(stack_parent "$b")" ] || stack_forget "$b"; else top="$b"; fi
      done
      [ "$(pr_state "$cur")" = MERGED ] && cur="${top:-$base}"
      git checkout -q "$cur";;
    prs)
      # The top branch carries every change below it: its gate marker stands for the stack.
      if [ "$tool" = gh-stack ]; then
        ghx stack top >/dev/null || die "gh stack top failed"
        local top; top=$(git branch --show-current)
        [ "$top" = "$cur" ] || die "the gate on $cur doesn't cover the branches above it: now on $top, the top of the stack; run orca-lc gate, then rerun"
      fi
      cmd_gate_fresh || die "gate marker missing or stale for this tree: run orca-lc gate before opening the stack's PRs"
      [ "$tool" = gh-stack ] && { ghx stack submit --auto; return; }
      local bs b p; bs=$(stack_branches); [ -n "$bs" ] || die "$cur is not in a stack"
      [ "$cur" = "$(tail -1 <<<"$bs")" ] || die "the gate on $cur doesn't cover the branches above it: check out $(tail -1 <<<"$bs"), run orca-lc gate, then rerun"
      local gv; gv=$(git version | awk '{print $3}')
      [ "$(printf '2.30\n%s\n' "$gv" | sort -V | head -1)" = 2.30 ] || die "git $gv is too old: stack prs needs git 2.30+ for --force-if-includes"
      for b in $bs; do
        [ "$(pr_state "$b")" = MERGED ] && die "$b is merged: run orca-lc stack rebase first"
        p=$(stack_parent "$b")
        # The lease alone passes after a fetch; --force-if-includes also needs the fetched tip in $b's history.
        git push -q --force-with-lease --force-if-includes -u origin "$b" || die "push of $b failed: someone else pushed to it? fetch and integrate their commits, then rerun"
        local pr; pr=$(ghx pr list --head "$b" --state open --json number,baseRefName -q '.[0] | select(.) | "\(.number) \(.baseRefName)"')
        if [ -z "$pr" ]; then ghx pr create --draft --base "$p" --head "$b" --fill >/dev/null || die "gh pr create for $b failed"; echo "$b: draft PR opened on $p"
        elif [ "${pr#* }" != "$p" ]; then ghx pr edit "${pr%% *}" --base "$p" >/dev/null || die "gh pr edit #${pr%% *} failed"; echo "$b: #${pr%% *} base ${pr#* } -> $p"
        else echo "$b: #${pr%% *} on $p"; fi
      done;;
    *) usage "stack add|list|rebase|prs";;
  esac
}

# ---- roles: the orchestrator starts each session in its own tab of the ticket's workspace
owner_file() { echo "$(shared)/owners/$(tkey "$1")"; }
cmd_role() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    owner)
      need ticket "${1:-}"; local f; f=$(owner_file "$1")
      [ "${2:-}" = --set ] && { need role "${3:-}"; mkdir -p "$(dirname "$f")"; echo "$3" > "$f"; }
      [ -f "$f" ] || die "no owner recorded for $1"
      local r a; r=$(cat "$f"); inherdr && a=$(resolve_target "$1" "$r" 2>/dev/null | jq -r .name)
      echo "$r${a:+ $a}";;
    start)
      need ticket "${1:-}"; need role "${2:-}"
      [ -z "${3:-}" ] || [ "$3" = --as ] || usage "role start <ticket> <role> [--as <name>]"
      inherdr || die "role start needs herdr"
      [ -t 0 ] && die "pipe the handoff body on stdin: orca-lc role start $1 $2 <<'EOF' ... EOF"
      local body; body=$(cat); [ -n "$body" ] || die "empty handoff body"
      leak_guard "role start handoff" "$body" || exit $?
      local t r as="" dir ws name; t=$(echo "$1" | tr 'a-z' 'A-Z'); r="$2"; dir=$(wt_dir "$t")
      [ "${3:-}" = --as ] && { need name "${4:-}"; as="$4"; }
      [ -d "$dir" ] || die "no worktree at $dir (orca-lc worktree up $t)"
      ws=$(wt_ws "$dir"); [ -n "$ws" ] || die "no herdr workspace for $dir (orca-lc worktree up $t)"
      name="$(tkey "${t//-/}")-$r"
      # Idempotent: a rerun after answering a startup prompt skips to the handoff and first prompt.
      local ag; ag=$(herdr agent list 2>/dev/null | jq -c --arg n "$name" '[.result.agents[] | select((.agent_name // .name)==$n)][0] // empty')
      if [ -z "$ag" ]; then
        local pane; pane=$(herdr tab create --workspace "$ws" --cwd "$dir" --label "$r" --env "ORCA_ROLE=$r" --no-focus | jq -r '.result.root_pane.pane_id // empty')
        [ -n "$pane" ] || die "herdr tab create returned no pane"
        if ! herdr agent start "$name" --kind claude --pane "$pane" --timeout 60000 >/dev/null 2>&1; then
          die "$name did not reach its prompt in pane $pane; a startup prompt (folder trust) is likely waiting. Answer it in tab '$r', then rerun this command"
        fi
      fi
      [ "$(herdr agent get "$name" 2>/dev/null | jq -r '.result.agent.agent_status // .result.agent_status')" = blocked ] && die "$name is blocked at a prompt; answer it in tab '$r', then rerun this command"
      local f; f=$(cmd_handoff write "$t" "$r" ${as:+--as "$as"}) || exit 1; printf '%s\n' "$body" >> "$f"
      case " propose apply review " in *" $r "*) cmd_role owner "$t" --set "$r" >/dev/null;; esac
      cmd_notify "$name" "You are the $r session for $t. Run: orca-lc handoff read $t $r, then work it. Report commits and decisions to the orchestrator (orca-lc notify $t --role orchestrator)."
      echo "handoff $f";;
    *) usage "role start|owner";;
  esac
}

cmd_context() {
  echo "orca-lc: project=$(cfg '.project') session=$(me id | cut -c1-8) name=$(me name) ticket=$(me ticket) role=$(me role) gate=$(cmd_gate_fresh && echo fresh || echo stale) test-edits=$(cmd_test_lock status)"
  local p; p=$(cmd_peers); [ -n "$p" ] && { echo "peers (this repo, all worktrees; first column is the notify target):"; echo "$p"; }
  local t; t=$(me ticket); [ -n "$t" ] && { local h; h=$(ls "$(tdir "$(shared)/handoffs" "$t")"/*.md 2>/dev/null | sort | tail -3); [ -n "$h" ] && { echo "unconsumed handoffs for $t (orca-lc handoff read $t <role>):"; echo "$h"; }; }
  cmd_inbox read
  local u; u=$(cmd_triage | wc -l); [ "$u" -gt 0 ] && echo "discoveries awaiting enforcement: $u (orca-lc triage)"
  local ec; ec=$(cfg '.envCommand'); if [ -n "$ec" ]; then local kv; kv=$(bash -c "$ec" 2>/dev/null); [ -n "$kv" ] && echo "gate env: $kv" || echo "WARNING: no stack for this worktree; gate tests will fail (orca-lc worktree up <ticket> --stack)"; fi
  [ -d .codegraph ] && has codegraph && codegraph status 2>/dev/null | grep -A3 'Pending sync' | head -4
}

cmd="${1:-}"; shift || true
# `<cmd> [args] -h|--help`: at the first -h|--help, print <cmd>'s USAGE lines (narrowed to `<cmd> <sub>` when the first
# arg names one), run nothing and ignore what follows. A known cmd exits 0 even with no usage line; an unknown one falls through.
help_of() { { [[ $1 =~ ^[a-z][a-z-]*$ ]] && grep -E "^  $cmd $1( |\$)" <<<"$USAGE"; } || grep -E "^  $cmd( |\$)" <<<"$USAGE"; return 0; }
if [[ $cmd =~ ^[a-z][a-z-]*$ ]] && { grep -qE "^  $cmd( |\$)" <<<"$USAGE" || declare -F "cmd_${cmd//-/_}" >/dev/null; }; then
  for ((i = 1; i <= $#; i++)); do case "${!i}" in -h|--help) sub=""; ((i > 1)) && sub=$1; help_of "$sub"; exit 0;; esac; done
fi
case "$cmd" in
  -h|--help|help|"") echo "$USAGE";;
  context) cmd_context;; gate) cmd_gate "$@";; gate-fresh) cmd_gate_fresh;; test-affected) cmd_test_affected;; evidence) cmd_evidence "$@";;
  leak-check) cmd_leak_check "$@";;
  peers) cmd_peers;; name) cmd_name "$@";; notify) cmd_notify "$@";; inbox) cmd_inbox "$@";; handoff) cmd_handoff "$@";;
  discover) cmd_discover "$@";; triage) cmd_triage;; tidy) cmd_tidy;; review-queue) cmd_review_queue;; test-lock) cmd_test_lock "$@";;
  worktree) cmd_worktree "$@";; config) cmd_config "$@";; role) cmd_role "$@";;
  stack) cmd_stack "$@";; ticket) ticket;;
  *) usage "unknown command '$cmd'";;
esac
